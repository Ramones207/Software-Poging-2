# STM32CubeIDE Project .gitignore (for project in subfolder FreeRTOS_GPS_407)

# --------------------------------------------------------------------------------
# 1. Eclipse and STM32CubeIDE Metadata/Settings (GLOBAL - ignore wherever they appear)
# These files define workspace and project-specific settings. They are often
# user-specific or temporary and should not be shared across collaborators.
# --------------------------------------------------------------------------------
.settings/
.metadata/
.log
# Note: .project, .cproject, .mxproject are critical for the IDE to recognize
# the project, so they are explicitly UN-IGNORED below for the project folder.

# --------------------------------------------------------------------------------
# 2. Build Artifacts (Generated Files - GLOBAL - ignore wherever they appear)
# These are files generated during the build process (compilation, linking).
# They can be regenerated by any user building the project.
# --------------------------------------------------------------------------------
# Build output directories
Debug/
debug/
Release/
release/
.vscode/
.clangd/
settings.json

# Intermediate object files
*.o
*.ko
*.obj

# Executables, firmware images, and debug symbols
*.elf
*.bin
*.hex
*.srec
*.map
*.lst
*.su

# Dependency files
*.d

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects
*.dll
*.so
*.so.*
*.dylib

# Other potential executables
*.exe
*.out
*.app
*.i*86
*.x86_64

# Debugging information
*.dSYM/
*.idb
*.pdb
.vscode/settings.json
